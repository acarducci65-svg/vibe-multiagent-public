{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoverContractV2",
  "description": "Schema formale machine-readable per contratti HANDOVER v2.1 in Vibe Multiagent",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "dispatch_id",
    "outcome",
    "base_sha",
    "head_sha",
    "acceptance_criteria",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.0",
        "2.1"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^(TASK|T)-[0-9A-Za-z_-]+$"
    },
    "dispatch_id": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "COMPLETO",
        "PARZIALE",
        "BLOCCATO"
      ]
    },
    "base_sha": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "SKIPPED"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code",
          "details"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "preserved"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "preserved": {
            "type": "boolean"
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
